#!/bin/bash
# set -e：任何命令失败立即退出；-u：引用未定义变量视为错误；-o pipefail：管道中任何一环失败，整条管道按失败处理
set -euo pipefail

# 依赖 bash ≥ 4.4 的特性（${var^^} 转大写、mapfile、空数组在 set -u 下展开）。
# macOS 自带 bash 3.2 不满足，需先 'brew install bash' 再用新版运行
if (( ${BASH_VERSINFO[0]:-0} * 100 + ${BASH_VERSINFO[1]:-0} < 404 )); then
  echo "phpbox 需要 bash ≥ 4.4（当前 ${BASH_VERSION:-未知}）；macOS 请先 'brew install bash'" >&2
  exit 1
fi

# 迁移第 5 步：入口薄化，按《新改造需求.txt》§七 固定加载链执行——
# 全局 common 六件套（env → log → paths → ports → docker → config）
# → 全局 install 事务框架 → 各服务线 common 全量 → 各线 versions（可选装载见下） → 各线 cli
# → load_env → lib/cli.sh（路由实现，含预检与分发）。
# versions/ 采用"可选装载"（迁移规范裁决 #1）：线 cli 分发时若命令带版本参数，且对应
# versions/<版本>.sh 存在，则追加 source——当前所有 versions 文件均为空占位，装载点
# 在各线 install 函数内部实现，属逻辑改写，按"搬运与改写分离"纪律排入后续独立切片。
# 旧 lib/*.sh 平铺桥仍在仓库，供外部旧路径 source 方过渡；确认无引用后（第 6 步）删除。
BASE_DIR="$HOME/phpbox"
LIB_DIR="$BASE_DIR/lib"

source "$LIB_DIR/common/env.sh"
source "$LIB_DIR/common/log.sh"
source "$LIB_DIR/common/paths.sh"
source "$LIB_DIR/common/ports.sh"
source "$LIB_DIR/common/docker.sh"
source "$LIB_DIR/common/config.sh"
source "$LIB_DIR/common/install.sh"

source "$LIB_DIR/php/common/install.sh"
source "$LIB_DIR/php/common/extensions.sh"
source "$LIB_DIR/php/common/apk-fetch.sh"
source "$LIB_DIR/php/common/offline.sh"
source "$LIB_DIR/php/common/build.sh"
source "$LIB_DIR/php/common/config.sh"
source "$LIB_DIR/mysql/common/install.sh"
source "$LIB_DIR/mysql/common/offline.sh"
source "$LIB_DIR/mysql/common/port.sh"
source "$LIB_DIR/mysql/common/config.sh"
source "$LIB_DIR/pgsql/common/install.sh"
source "$LIB_DIR/pgsql/common/offline.sh"
source "$LIB_DIR/pgsql/common/port.sh"
source "$LIB_DIR/pgsql/common/config.sh"
source "$LIB_DIR/redis/common/install.sh"
source "$LIB_DIR/redis/common/offline.sh"
source "$LIB_DIR/redis/common/port.sh"
source "$LIB_DIR/redis/common/config.sh"
source "$LIB_DIR/nginx/common/install.sh"
source "$LIB_DIR/nginx/common/offline.sh"
source "$LIB_DIR/nginx/common/reload.sh"
source "$LIB_DIR/nginx/common/config.sh"
source "$LIB_DIR/site/common/add.sh"
source "$LIB_DIR/site/common/switch.sh"
source "$LIB_DIR/site/common/list.sh"
source "$LIB_DIR/site/common/hosts.sh"
source "$LIB_DIR/go/common/install.sh"
source "$LIB_DIR/go/common/run.sh"
source "$LIB_DIR/go/common/server.sh"
source "$LIB_DIR/backup/common/backup.sh"
source "$LIB_DIR/backup/common/restore.sh"

source "$LIB_DIR/php/cli.sh"
source "$LIB_DIR/mysql/cli.sh"
source "$LIB_DIR/pgsql/cli.sh"
source "$LIB_DIR/redis/cli.sh"
source "$LIB_DIR/nginx/cli.sh"
source "$LIB_DIR/site/cli.sh"
source "$LIB_DIR/go/cli.sh"
source "$LIB_DIR/backup/cli.sh"

load_env

# 路由实现与全局命令（show_help/cmd_list/预检/分发）在此文件末尾展开
source "$LIB_DIR/cli.sh"
