PROJECT_NAME=phpbox
NETWORK_NAME=phpboxnet
WWW_ROOT=/home/kentrl/www
MYSQL_DATA_ROOT=/home/kentrl/mysql-data
CURRENT_UID=1000
CURRENT_GID=1000
NGINX_PORT=80
# Nginx 镜像 tag（默认 alpine）；换 tag 只会改变主配置目录，站点目录恒为 config/nginx/sites
NGINX_VERSION=alpine
PHP_SERVICE_PREFIX=php
MYSQL_SERVICE_PREFIX=mysql
REDIS_SERVICE_PREFIX=redis
NGINX_SERVICE_PREFIX=nginx
LABEL_SEPARATOR=-
IMAGE_TAG_SEPARATOR=-
BACKUP_NAME_SEPARATOR=-
IMAGE_PREFIX=phpbox
MYSQL_80_PORT=3380
MYSQL_80_ROOT_PASSWORD=改成你的密码
MYSQL_84_PORT=3384
MYSQL_84_ROOT_PASSWORD=改成你的密码

# PHP 默认安装扩展集（php install 不带 --ext 时生效）。
# curl/openssl/mbstring/pdo/sqlite3/xml 系/dom/fileinfo/sodium/pcntl 等已内置于 php-fpm-alpine 镜像，无需列出；
# mongodb/memcached/sqlsrv/ldap 等低频扩展不进默认集，需要时 phpbox php extension add 单独装
PHP_DEFAULT_EXTENSIONS=gd,redis,pdo_mysql,mysqli,pgsql,pdo_pgsql,zip,bcmath,intl,opcache,exif,soap,sockets,imagick,xdebug

# 离线备份库：pecl 源码包与 apk 依赖闭包的持久存放地（按 服务/<版本>/pecl、apk 分目录），
# 构建时优先命中、成功后沉淀，换机随 phpbox backup 迁移；手动离线放包放对应版本目录即可
OFFLINE_DIR=~/phpbox/offline
# Alpine 镜像源兜底列表（空格分隔）：内置默认源（阿里云主源 + 官方 CDN）始终参与，
# 这里的源是追加的兜底；下载前容器内会逐源测速，按最快优先整批下载（闭包出自同一源），
# 索引获取超时、下载"无响应"判定共用 APK_TIMEOUT，超时即杀掉并自动切换测速次快的源
APK_MIRRORS="http://sunsite.icm.edu.pl/Linux/dist/alpine https://freshmeat.icm.edu.pl/packages/linux-alpine"
# 镜像源网络超时秒数（正整数，默认 30）：源测速 / 索引获取 / 下载无响应判定三处共用
APK_TIMEOUT=20
