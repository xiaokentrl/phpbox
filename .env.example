PROJECT_NAME=phpbox
NETWORK_NAME=phpboxnet
WWW_ROOT=/home/kentrl/www
MYSQL_DATA_ROOT=/home/kentrl/mysql-data
CURRENT_UID=1000
CURRENT_GID=1000
NGINX_PORT=80
PHP_SERVICE_PREFIX=php
MYSQL_SERVICE_PREFIX=mysql
REDIS_SERVICE_PREFIX=redis
NGINX_SERVICE_PREFIX=nginx
LABEL_SEPARATOR=-
IMAGE_TAG_SEPARATOR=-
BACKUP_NAME_SEPARATOR=-
IMAGE_PREFIX=phpbox
MYSQL_80_PORT=3380
MYSQL_80_ROOT_PASSWORD=123456
MYSQL_84_PORT=3384
MYSQL_84_ROOT_PASSWORD=123456

# PHP 默认安装扩展集（php install 不带 --extensions 时生效）。
# curl/openssl/mbstring/pdo/sqlite3/xml 系/dom/fileinfo/sodium/pcntl 等已内置于 php-fpm-alpine 镜像，无需列出；
# mongodb/memcached/sqlsrv/ldap 等低频扩展不进默认集，需要时 phpbox php extension add 单独装
PHP_DEFAULT_EXTENSIONS=gd,redis,pdo_mysql,mysqli,pgsql,pdo_pgsql,zip,bcmath,intl,opcache,exif,soap,sockets,imagick,apcu,xdebug