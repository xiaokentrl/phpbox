PROJECT_NAME=phpbox
NETWORK_NAME=phpboxnet
WWW_ROOT=/home/kentrl/www
MYSQL_DATA_ROOT=/home/kentrl/mysql-data
CURRENT_UID=1000
CURRENT_GID=1000
NGINX_PORT=80
# Nginx 镜像 tag（默认 alpine）；换 tag 只会改变主配置目录，站点目录恒为 config/nginx/sites
NGINX_VERSION=alpine
PHP_SERVICE_PREFIX=php
MYSQL_SERVICE_PREFIX=mysql
REDIS_SERVICE_PREFIX=redis
NGINX_SERVICE_PREFIX=nginx
LABEL_SEPARATOR=-
IMAGE_TAG_SEPARATOR=-
BACKUP_NAME_SEPARATOR=-
IMAGE_PREFIX=phpbox-
MYSQL_57_PORT=3357
MYSQL_57_ROOT_PASSWORD=改成你的密码
MYSQL_80_PORT=3380
MYSQL_80_ROOT_PASSWORD=改成你的密码
MYSQL_84_PORT=3384
MYSQL_84_ROOT_PASSWORD=改成你的密码
# Redis 安装后会按版本自动写入 REDIS_<去点版本>_PORT 和 REDIS_<去点版本>_ROOT_PASSWORD
PHP_DEFAULT_EXTENSIONS=gd,redis,pdo_mysql,mysqli,pgsql,pdo_pgsql,zip,bcmath,intl,opcache,exif,soap,sockets,imagick,xdebug
OFFLINE_DIR=./offline
APK_MIRRORS="http://sunsite.icm.edu.pl/Linux/dist/alpine https://freshmeat.icm.edu.pl/packages/linux-alpine"
# 镜像源网络超时秒数
APK_TIMEOUT=20
# Go 项目：GO_PROJECTS_ROOT 的直接子目录中存在 go.mod 即自动发现
GO_PROJECTS_ROOT=/home/kentrl/www
# alpine 表示官方最新稳定 Alpine 镜像；指定版本时使用 golang:<版本>-alpine
GO_DEFAULT_VERSION=alpine
# Go 应用容器内默认监听端口，项目根目录 .env 的 GO_PORT 可覆盖
GO_DEFAULT_PORT=8080
# 国内模块代理；模块缓存仍保存在 GO_CACHE_ROOT，不代表完整离线仓库
GO_PROXY=https://goproxy.cn,direct
# 按 Go 镜像版本持久化 GOPATH（pkg/mod、bin）
GO_CACHE_ROOT=/home/kentrl/phpbox/cache/go
# 传入 Go 容器的默认 CGO_ENABLED 值
GO_CGO_ENABLED=0
GO_SERVICE_PREFIX=go

