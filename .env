PROJECT_NAME=phpbox
NETWORK_NAME=phpboxnet
WWW_ROOT=/home/kentrl/www
MYSQL_DATA_ROOT=/home/kentrl/mysql-data
CURRENT_UID=1000
CURRENT_GID=1000
NGINX_PORT=80
PHP_SERVICE_PREFIX=php
MYSQL_SERVICE_PREFIX=mysql
REDIS_SERVICE_PREFIX=redis
NGINX_SERVICE_PREFIX=nginx
LABEL_SEPARATOR=-
IMAGE_TAG_SEPARATOR=-
BACKUP_NAME_SEPARATOR=-
IMAGE_PREFIX=phpbox
MYSQL_80_PORT=3380
MYSQL_80_ROOT_PASSWORD=123456
MYSQL_84_PORT=3384
MYSQL_84_ROOT_PASSWORD=123456
MYSQL_57_PORT=3357
MYSQL_57_ROOT_PASSWORD=123456
PHP_DEFAULT_EXTENSIONS=gd,redis,pdo_mysql,mysqli,pgsql,pdo_pgsql,zip,bcmath,intl,opcache,exif,soap,sockets,imagick,xdebug
# 离线备份库：pecl 源码包与 apk 依赖闭包的持久存放地（按 服务/<版本>/pecl、apk 分目录），
# 构建时优先命中、成功后沉淀，换机随 phpbox backup 迁移；手动离线放包放对应版本目录即可
OFFLINE_DIR=~/phpbox/offline
APK_MIRRORS="https://mirrors.aliyun.com/alpine http://sunsite.icm.edu.pl/Linux/dist/alpine https://freshmeat.icm.edu.pl/packages/linux-alpine"